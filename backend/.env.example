# Knowledge Wars - backend environment template
#
# Copy to backend/.env for local development, or set these as environment
# variables in the hosting panel (Render) for production.
#
# NEVER commit real values. .env is gitignored; this template is not.
# Every variable below is required - the server refuses to start without them.

# Signing key for session JWTs (HS256). Generate a fresh random value:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Shared secret guarding every /api/admin/* route. Generate the same way as
# JWT_SECRET. This is the only control on coupon creation, ELO resets and
# data deletion, so treat it as a production credential.
ADMIN_SECRET=

# MongoDB connection string, including its own dedicated user and password.
MONGO_URL=

# MongoDB database name.
DB_NAME=

# Comma-separated list of browser origins allowed to call this API.
# A wildcard is rejected at startup because the API sends credentials.
#   CORS_ORIGINS=https://knowledgewars.app,https://www.knowledgewars.app
CORS_ORIGINS=

# Anthropic API key used for question generation.
ANTHROPIC_API_KEY=

# Stripe secret key used for checkout.
STRIPE_API_KEY=
