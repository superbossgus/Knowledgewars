# Knowledge Wars - backend environment template
#
# Copy to backend/.env for local development, or set these as environment
# variables in the hosting panel (Render) for production.
#
# NEVER commit real values. .env is gitignored; this template is not.
# Las variables del primer bloque son obligatorias: el servidor se niega a
# arrancar sin ellas. Al final hay un bloque de opcionales.

# Signing key for session JWTs (HS256). Generate a fresh random value:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Shared secret guarding every /api/admin/* route. Generate the same way as
# JWT_SECRET. This is the only control on coupon creation, ELO resets and
# data deletion, so treat it as a production credential.
ADMIN_SECRET=

# MongoDB connection string, including its own dedicated user and password.
MONGO_URL=

# MongoDB database name.
DB_NAME=

# Comma-separated list of browser origins allowed to call this API.
# A wildcard is rejected at startup because the API sends credentials.
#   CORS_ORIGINS=https://knowledgewars.app,https://www.knowledgewars.app
CORS_ORIGINS=

# Anthropic API key used for question generation.
ANTHROPIC_API_KEY=

# Stripe secret key used for checkout.
STRIPE_API_KEY=

# ---------------------------------------------------------------------------
# Opcionales. El servidor arranca sin ellas.
# ---------------------------------------------------------------------------

# Entorno. Se lee con "production" por omision: un olvido falla cerrado.
# Ponla en "development" solo en tu maquina.
#   ENVIRONMENT=development
ENVIRONMENT=

# Envio del codigo de recuperacion de contrasena (BOS-353).
#
# Sin SMTP_HOST y SMTP_FROM no se manda nada: el endpoint contesta lo mismo,
# pero el usuario no recibe el codigo y no puede recuperar su cuenta. Se habla
# SMTP para que cambiar de proveedor (Brevo, Resend, Amazon SES, Google
# Workspace) sea poner estas variables y nada mas.
#
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=...
#   SMTP_PASSWORD=...            <- credencial de produccion, nunca en el repo
#   SMTP_FROM=Knowledge Wars <no-reply@tu-dominio>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 1 por omision. Apagarla solo tiene sentido contra un relay local.
SMTP_STARTTLS=
# Segundos de espera al proveedor. 10 por omision.
SMTP_TIMEOUT=

# Camino de desarrollo: escribe el codigo de recuperacion en el log del
# servidor cuando no hay SMTP. El codigo NUNCA viaja en la respuesta HTTP.
# El arranque FALLA si esto esta encendido y ENVIRONMENT no es "development".
PASSWORD_RESET_LOG_CODE=
